# Copy on the server only. Never commit the filled-in file.
#
#   /opt/projects/sch.oleq.app/.env.production
#
# `make deploy` loads .env.production.
# CI uploads Makefile, docker-compose.yml, and arise_to_excel.sql.
# It does not upload this env file, and the image does not contain it.
#
# docker-compose.yml forces ARISE_DB_HOST=db and ARISE_DB_PORT=3306.
# ARISE_APP_ENV=production makes the app refuse to start when DB credentials are missing.

ARISE_APP_ENV=production

MYSQL_ROOT_PASSWORD=changeme-root-password
MYSQL_DATABASE=arise_to_excel
MYSQL_USER=arise
MYSQL_PASSWORD=changeme-db-password
